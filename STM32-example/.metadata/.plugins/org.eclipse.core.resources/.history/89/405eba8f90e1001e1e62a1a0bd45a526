// 1. Given an array by user that need to be swapped like element at A[0] with A[1], A[2] with A[3], etc.
// 2. Given an array by user that need to be swapped half of array together
#include <stdio.h>
#include <stdint.h>

void array_input(int32_t *arr, uint32_t size_arr);
void array_display(int32_t *arr, uint32_t size_arr);
void swap_even(int32_t *arr, uint32_t size_arr);
void swap_half(int32_t *arr, uint32_t size_arr);

int main()
{
	uint32_t size_array;
	printf("Enter size of array: ");
	scanf("%u", &size_array);

	int32_t array[size_array];
	printf("Enter elements of array: ");
	array_input(array,size_array);

	printf("Before swapping: ");
	array_display(array, size_array);

	printf("After swapping: ");
	swap_half(array, size_array);
	array_display(array, size_array);
	return 0;
}

void array_input(int32_t *arr, uint32_t size_arr)
{
	for(uint32_t i = 0; i < size_arr; i++)
	{
		scanf("%u ", &(*(arr+i)));
	}
}

void array_display(int32_t *arr, uint32_t size_arr)
{
	for(uint32_t i = 0; i < size_arr; i++)
	{
		printf(" %u ", *(arr+i));
	}
}

void swap_even(int32_t *arr, uint32_t size_arr)
{
	for(uint32_t i = 0; i < size_arr; i+=2)
	{
		arr[i] = arr[i] + arr[i+1];
		arr[i+1] = arr[i] - arr[i+1];
		arr[i] = arr[i] - arr[i+1];
	}
}

void swap_half(int32_t *arr, uint32_t size_arr)
{
	for(uint32_t i = 0; i < size_arr/2; i++)
	{
		arr[i] = arr[i] + arr[i+size_arr/2];
		arr[i+size_arr] = arr[i] - arr[i+size_arr];
		arr[i] = arr[i] - arr[i+size_arr];
	}
}
