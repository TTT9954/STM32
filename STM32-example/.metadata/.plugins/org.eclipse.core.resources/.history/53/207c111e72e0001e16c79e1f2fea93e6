#include <stdio.h>
#include <stdint.h>

typedef struct data
{
	char data1;
	int data2;
	char data3;
	short data4;
}datas;

int main()
{
	datas data;
	datas *ptr_data;
	data.data1 = 0x11;
	data.data2 = 0xFFEE1122;
	data.data3 = 0x22;
	data.data4 = 0x1122;

	ptr_data = &data;
	for(int i = 0; i<sizeof(ptr_data); i++)
	{
		printf("Value %x at address %p \n", *(ptr_data+i), ptr_data+i);
	}
	return 0;
}


