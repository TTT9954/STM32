#include <stdio.h>
#include <stdint.h>

typedef struct data
{
	int data1;
	char data2;
	float data3;
	double data4;
}datas;

int main()
{
	datas data;
	data.data1 = 0xAACCBB11;
	data.data2 = 0x1122;
	data.data3 = 0x33;
	data.data4 = 0x11221233;
	printf("Total size: %llu", sizeof(datas));

	uint32_t *ptr = (uint32_t *)&data;

	for(int i = 0; i<sizeof(data); i++)
	{
		printf("0x%x at %p \n", *ptr,ptr);
		ptr++;
	}

	return 0;
}


