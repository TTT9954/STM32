#include <stdio.h>
#include <stdint.h>

typedef struct data
{
	char data1;
	int data2;
	char data3;
	short data4;
}data;

int main()
{
	data data;
	data.data1 = 0x11;
	data.data2 = 0xFFEE1122;
	data.data3 = 0x22;
	data.data4 = 0x1122;

	uint8_t *ptr = (uint8_t *)&data;
	*ptr = 0x55;
	ptr = ptr+3;
	*ptr = 0x23;

	printf("data1: %x", data.data1);
	return 0;
}


