#include <stdint.h>

#define delay() for(uint32_t i=0; i<=100000; i++);

uint8_t ledState = 0;
uint32_t volatile *const clk_en_reg = (uint32_t *)(0x40023800 + 0x30); // RCC memory mapped

uint32_t volatile *const gpioA_mode = (uint32_t *)(0x40020000 + 0x00); // GPIOA memory mapped
uint32_t volatile *const gpioA_input = (uint32_t *)(0x40020000 + 0x10); // GPIOx_IDR

uint32_t volatile *const gpioD_mode = (uint32_t *) 0x40020C00; // GPIOD memory mapped
uint32_t volatile *const gpioD_output = (uint32_t *) 0x40020C14; // GPIOx_ODR

uint8_t read_state = 0;

void toggle_LED();

int main(void)
{

    // Enable clock for GPIOA and GPIOD peripheral in AHPB1
    *clk_en_reg |= (1 << 0) | (1 << 3);

    // configuring PD12 as OUTPUT mode
    *gpioD_mode &= ~(3 << 24);
    *gpioD_mode |= (1 << 24);

    // configuring PA0 as INPUT mode
    *gpioA_mode &= ~(3 << 0);

    uint8_t count = 0;
    uint8_t last_state = (*gpioA_input & (1 << 0));
    while(1)
    {
    	// Read status GPIOA
    	read_state = *gpioA_input & (1 << 0);

    	if (read_state != last_state)
    	{
    		last_state = read_state;
    		if (read_state == 1)
    		{
    			delay();
    			while(read_state != last_state);
    			delay();
    			*gpioD_output ^= (1 << 12);
    		}
    	}
    	//else *gpioD_output &= ~(1 << 12);
    }

    return 0;

}

void toggle_LED()
{
	if(ledState == 0)
	{
		*gpioD_output |= (1 << 12);
		ledState = 1;
	}
	else if(ledState == 1)
	{
		*gpioD_output &= ~(1 << 12);
		ledState = 0;
	}
}
