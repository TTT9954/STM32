#include <stdio.h>
#include <stdint.h>

void wait_for_user_input();

int main()
{
	uint8_t start_num, end_num, even_count;
	printf("Enter starting and ending numbers: ");
	scanf("%hhd %hhd", &start_num, &end_num);

	if(end_num < start_num)
	{
		printf("Ending number is greater than start number\n");
		wait_for_user_input();
		return 0;
	}

	printf("Even numbers are: \n");
	while(start_num <= end_num)
	{
		if(!(start_num % 2))
		{
			printf("%4d\n", start_num);
			even_count++;
		}
		start_num++;
	}

	printf("Total even numbers: %d\n", even_count);

	wait_for_user_input();
	return 0;
}

void wait_for_user_input()
{
	printf("Press enter to exit the application");
	while(getchar() != '\n');
	getchar();
}

