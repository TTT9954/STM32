#include <stdio.h>
#include <stdint.h>

typedef struct data
{
	char data1;
	int data2;
	char data3;
	short data4;
}datas;

int main()
{
	datas data;
	datas *ptr_data;
	data.data1 = 0x11;
	data.data2 = 0xFFEE1122;
	data.data3 = 0x22;
	data.data4 = 0x1122;

	uint8_t *ptr = (uint8_t)ptr_data;
	for(int i = 0; i<sizeof(ptr_data); i++)
	{
		printf("0x%x at %p \n", *ptr,ptr+i);
	}
	return 0;
}


