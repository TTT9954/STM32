void init_PORT()
{
    // 1. Enable the clock for GPIOD peripheral in the AHB1ENR
    *RCC_AHB1ENR |= (1 << 0) | (1 << 1) | (1 << 2) | (1 << 3); // SET 3th bit position as 1


    // Configure PB8 -> PB14 as OUTPUT
        *GPIOB_MODER |= 0x15550000;

    // Configure PC0 -> PC3 as OUTPUT
    *GPIOC_MODER |= (1 << 0) | (1 << 2) | (1 << 4) | (1 << 6);


    // + Configure PD0, PD1, PD2 as INPUT (cols)
    // + Configure PD3, PD4, PD5, PD6 as OUTPUT (rows)
    *GPIOD_MODER |= 0x5540;

    // Configure PD0, PD1, PD2 INPUT PULLUP INTERNAL
    *GPIOD_PUPD |= 0x15;

}

void delayMs(uint32_t n)
{
    int i;
    for (; n > 0; n--)
        for (i = 0; i < 3200; i++) ;
}

void SEVSEG_putdigit(unsigned char szam, unsigned char digit)
{
	*GPIOC_ODR = (1 << digit);
	*GPIOB_ODR = seven_seg[szam];
	delayMs(1);
	*GPIOC_ODR = 0x00;
	*GPIOB_ODR |= 0xFF;

}

void SEVSEG_putnumber_t(int number)
{
	digit[3] = number/1000;

	digit[2] = number/100%10;

	digit[1] = number/10%10;

	digit[0] = number%10;

	SEVSEG_putdigit(digit[j], j);
	j = (j+1)%4;
	delayMs(1);
	*GPIOC_ODR = 0x00;
}

