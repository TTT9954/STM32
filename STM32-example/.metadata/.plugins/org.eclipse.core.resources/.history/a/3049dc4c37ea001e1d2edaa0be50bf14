void keypad_scan()
{
	unsigned char num, bill;
	*GPIOD_ODR = row;
	//delayMs(1);
	bill = *GPIOD_IDR & 0x7F;
	num = 0;
	while(num < 12)
	{
		if(bill == matrix_keyboard[num])
		{
			while((*GPIOD_IDR & 0x7F) == matrix_keyboard[num]);
			m_button = num;
			break;
		}
		else
		{
			m_button = 12;
			num++;
		}
	}
	if(row == 0x38) row = 0x70;
	else row = ((row << 1) + 0x08) & 0x7F;
}

void matrix_display_segment()
{
	keypad_scan();
	//delayMs(1);
	uint8_t i=1;
	if(m_button <= 9)
	{
		i=3;
		while(i)
		{
			digit[i] = digit[i-1];
			i--;
		}
		digit[0] = m_button;
	}
	SEVSEG_putnumber_matrix();


}



