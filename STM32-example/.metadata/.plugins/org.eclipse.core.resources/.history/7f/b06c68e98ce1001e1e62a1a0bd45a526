// Swap elements in even positions to their adjacent odd positions in the Array
// Given an array by user that need to be swapped like element at A[0] with A[1], A[2] with A[3], etc.

#include <stdio.h>
#include <stdint.h>

void array_input(uint32_t *arr, uint32_t size_arr);
void array_display(uint32_t *arr, uint32_t size_arr);

int main()
{
	uint32_t *array, size_array;
	printf("Enter size of array: ");
	scanf("%u", &size_array);

	printf("Enter elements of array: ");

	return 0;
}

void array_input(uint32_t *arr, uint32_t size_arr)
{
	for(uint32_t i = 0; i < size_arr; i++)
	{
		scanf("a[%u]= %u", &i, &(*(arr+i)));
	}
}

void array_display(uint32_t *arr, uint32_t size_arr)
{
	for(uint32_t i = 0; i < size_arr; i++)
	{
		printf("a[%u]= %u", i, *(arr+i));
	}
}
