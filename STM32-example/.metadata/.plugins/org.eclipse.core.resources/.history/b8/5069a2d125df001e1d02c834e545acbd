#include <stdio.h>
#include <stdint.h>

void wait_for_input_user();

int main()
{
	uint8_t const data = 10;
	uint8_t const *ptr = (uint8_t *)&data;
	ptr = (uint8_t *) 0x1234455;
	printf("Value: %p", ptr);
	fflush(stdout);
	wait_for_input_user();
	return 0;
}

void wait_for_input_user()
{
	printf("\nPress enter to exit the application");
	while(getchar() != '\n');
	getchar();
}

