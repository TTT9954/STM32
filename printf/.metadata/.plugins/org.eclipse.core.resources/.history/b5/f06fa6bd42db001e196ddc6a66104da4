#include <stdio.h>

int compare(int,int);
int main()
{
	int number1, number2;
	int check;
	printf("Enter number 1: ");
	fflush(stdout);
	scanf("%d", &number1);
	printf("Enter number 2: ");
	fflush(stdout);
	scanf("%d", &number2);
	check = compare(number1,number2);
	if(!check)
	{
		printf("Number 1 is not greater than number 2");
	}
	else
	{
		if(check > 0) printf("Number 1 is greater than number 2");
		else printf("Number 1 is equal number 2");
	}

	printf("Press Enter to exit the application");
	getchar();
	getchar();
	return 0;
}

int compare(int a, int b)
{
	if(a>b) return 1;
	else if(a<b) return -1;
	else return 0;
}

