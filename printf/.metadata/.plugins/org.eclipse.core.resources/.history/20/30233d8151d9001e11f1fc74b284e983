#include <stdio.h>
#include "math.h"

int main()
{
	char c1,c2,c3,c4,c5,c6;
	printf("Enter any 6 characters of your choice: ");
	fflush(stdout);
	scanf("%c %c %c %c %c %c", &c1, &c2, &c3, &c4, &c5, &c6);
	printf("ASCII code: %d %d %d %d %d %d\n", c1, c2, c3, c4, c5, c6);
	printf("Please press Enter to exit the application");
	while(getchar() != '\n');
	getchar();
	return 0;
}


