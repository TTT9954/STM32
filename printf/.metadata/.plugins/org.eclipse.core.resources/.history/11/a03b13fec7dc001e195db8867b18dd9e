#include <stdio.h>
#include <stdint.h>

#define PI 3.14

void wait_input();
int main()
{
	char choice;
	float Area;
	printf("----------Area calculation program----------\n");
	printf("Circle ---> c\n");
	printf("Triangle ---> t\n");
	printf("Rectangle ---> r\n");
	printf("Square ---> s\n");
	printf("Trapezoid ---> z\n");
	printf("Please input 1 character: ");
	scanf("%c", &choice);
	switch(choice)
	{
		case 'c':
			float radius;
			printf("--Circle Area calculation--\n");
			printf("Please input Radius: ");
			scanf("%f", &radius);
			if(radius < 0)
			{
				printf("Radius cannot be negative !");
				Area = -1;
			}
			else Area = PI*radius*radius;
			break;
		case 't':
			float base;
			float height;
			printf("--Triangle Area calculation--\n");
			printf("Please input Base: ");
			scanf("%f", &base);
			printf("Please input Height: ");
			scanf("%f", &height);
			if((base < 0) || (height < 0))
			{
				printf("Base or Height cannot be negative !");
				Area = -1;
			}
			else Area = (height*base)/2;
			break;
		case 'r':
			float width;
			float length;
			printf("--Rectangle Area calculation--\n");
			printf("Please input Length: ");
			scanf("%f", &length);
			printf("Please input Width: ");
			scanf("%f", &width);
			if((length < 0) || (width < 0))
			{
				printf("Length or Width cannot be negative !");
				Area = -1;
			}
			else Area = (length*width);
			break;
		case 's':
			float side;
			printf("--Square Area calculation--\n");
			printf("Please input Side: ");
			scanf("%f", &side);
			if(side < 0)
			{
				printf("Side cannot be negative !");
				Area = -1;
			}
			else Area = side*side;
			break;
		case 'z':
			float base_top, base_down, height_z;
			printf("--Trapezoid Area calculation--\n");
			printf("Please input Base top: ");
			scanf("%f", &base_top);
			printf("Please input Base down: ");
			scanf("%f", &base_down);
			printf("Please input Height: ");
			scanf("%f", &height_z);
			Area = ((base_top+base_down)*height_z)/2;
			break;
		default:
			printf("Invalid input !\n");
			Area = -1;
			break;
	}
	if(!(Area < 0))
	{
		printf("Area: %f\n", Area);
	}
	wait_input();
	return 0;
}

void wait_input()
{
	printf("Please enter to exit the application");
	while(getchar() != '\n');
	getchar();
}

