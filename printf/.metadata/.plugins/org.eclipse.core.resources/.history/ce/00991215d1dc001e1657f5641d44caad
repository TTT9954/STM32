#include <stdio.h>
#include <stdint.h>

void wait_for_inputting();
int main()
{
	uint32_t number;
	printf("Enter your number: ");
	scanf("%d", &number);
	if(number&1) printf("Number is Odd\n");
	else printf("Number is Even");
	wait_for_inputting();
	return 0;
}

void wait_for_inputting()
{
	printf("Press enter to exit the application");
	while(getchar() != '\n');
	getchar();

}
