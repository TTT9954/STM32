	scanf("%f", &number1);
	printf("Enter number 2: ");
	scanf("%f", &number2);
	int n1 = number1;
	int n2 = number2;
	check = compare(number1,number2);
	if((n1 != number1) || (n2 != number2))
	{
		printf("Just compare integer part !");
	}
	if(check == 0)
	{
		printf("Number 1 is equal number 2\n");
	}
	else
	{
		if(check > 0) printf("Number 1 is greater than number 2\n");
		else printf("Number 1 is not greater than number 2\n");
	}
