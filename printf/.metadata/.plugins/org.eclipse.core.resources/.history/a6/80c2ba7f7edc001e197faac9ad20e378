#include <stdio.h>

int compare(int,int);
void wait_for_user_input(void);
int main()
{
	float number1, number2;
	int check;
	printf("Enter number 1: ");
	if(scanf("%f", &number1) == 0){
		printf("Invalid input! Exiting ...\n");
		return 0;
	}
	printf("Enter number 2: ");
	if(scanf("%f", &number2) == 0){
			printf("Invalid input! Exiting ...\n");
			return 0;
	}
	int n1 = number1;
	int n2 = number2;
	check = compare(number1,number2);
	if((n1 != number1) || (n2 != number2))
	{
		printf("Just compare integer part !\n");
	}
	if(check == 0)
	{
		printf("Number 1 is equal number 2\n");
	}
	else
	{
		if(check > 0) printf("Number 1 is greater than number 2\n");
		else printf("Number 1 is not greater than number 2\n");
	}

	return 0;
}

int compare(int a, int b)
{
	if(a>b) return 1;
	else if(a<b) return -1;
	else return 0;
}

void wait_for_user_input()
{
	while(getchar()!= '\n')
	{
		printf("Press Enter to exit the application");
	}
	getchar();
}
