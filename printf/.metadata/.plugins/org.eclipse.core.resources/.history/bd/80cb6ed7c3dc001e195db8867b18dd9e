	printf("Rectangle ---> r\n");
	printf("Square ---> s\n");
	printf("Trapezoid ---> z\n");
	printf("Please enter character: ");
	scanf("%c", &choice);
	switch(choice)
	{
		case 'c':
			float radius;
			printf("Please enter Radius: ");
			scanf("%f", &radius);
			Area = radius * PI;
			printf("Area of Circle: %f\n", Area);
			wait_input();
			break;
		case 't':
			float base;
			float height;
			printf("Please enter Base: ");
			scanf("%f", &base);
			printf("Please enter Height: ");
			scanf("%f", &height);
			Area = (heigh*base)/2;
			printf("Area of Circle: %f\n", Area);
			wait_input();
			break;
		default:
			wait_input();
			break;
	}

	return 0;
}

