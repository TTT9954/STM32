#include <stdio.h>

int main()
{
	double charge;
	double charge_of_electron;
	double total_number_of_electrons;
	printf("Enter number of charge: ");
	scanf("%lf", &charge);
	printf("Enter charge of electron: ");
	scanf("%le", &charge_of_electron);

	total_number_of_electrons = (charge/charge_of_electron)*-1;

	printf("\nTotal number of electrons: %lf", total_number_of_electrons);
	printf("\nTotal number of electrons: %le", total_number_of_electrons);


	while(getchar()!='\n') {
		printf("\n\nPress Enter to exit the application");
	}

	getchar();

	return 0;

}


