#include <stdio.h>
#include <stdint.h>

void wait_for_input_user();

int main()
{
	uint8_t const data = 10;
	uint8_t *ptr = (uint8 *)&data;
	*ptr = 100;
	printf("Value: %d", data);
	wait_for_input_user();
	return 0;
}

void wait_for_input_user()
{
	printf("\nPress enter to exit the application");
	while(getchar() != '\n');
	getchar();
}

