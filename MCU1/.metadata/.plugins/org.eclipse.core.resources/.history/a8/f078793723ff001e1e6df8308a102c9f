// Other function APIs
void SPI_SSI_Configure(SPI_RegDef_t *SPIx, uint8_t EnorDis)
{
	if(EnorDis == ENABLE)
	{
		SPIx->SPI_CR1 |= 1 << SPI_CR1_SSI;
	}
	else SPIx->SPI_CR1 &= ~(1 << SPI_CR1_SSI);
}

void SPI_SSOE(SPI_RegDef_t *SPIx, uint8_t EnorDis)
{
	if(EnorDis == ENABLE)
	{
		SPIx->SPI_CR2 |= (1 << SPI_CR2_SSOE);
	}
	else SPIx->SPI_CR2 &= ~(1 << SPI_CR2_SSOE);
}


void SPI_ACTIVE_DEACTIVE(SPI_RegDef_t *SPIx, uint8_t EnorDis)
{
	if(EnorDis == ENABLE)
	{

		if((SPIx->SPI_CR1 & (1 << SPI_CR1_SSM)) == SSM_HARDWARE)
		{
			SPI_SSOE(SPIx, EnorDis);
		}
		else
		{
			SPI_SSI_Configure(SPIx, EnorDis);
		}

		SPIx->SPI_CR1 |= (1 << SPI_CR1_SPE);

	}
	else
	{

		SPIx->SPI_CR1 &= ~(1 << SPI_CR1_SPE);
	}
}




