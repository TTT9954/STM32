#include "SPI.h"

void LED_GPIO_Init()
{
	__HAL_RCC_GPIOD_CLK_ENABLE();

	*GPIOD_MODER &= ~(3 << 6);

	*GPIOD_MODER |= (1 << 6);

	*GPIOD_ODR |= (1 << 3);

}

void LED_TOGGLE()
{
	*GPIOD_ODR ^= (1 << 3);
}
void Button_GPIO_Init()
{
	__HAL_RCC_GPIOD_CLK_ENABLE();

	*GPIOD_MODER &= ~(0x3 << 0);
}

uint8_t button_state()
{
	return (*GPIOD_IDR & (1 << 0));
}

void NVIC_Init()
{
	*NVIC_ISER0 |= (1 << 5);
	*NVIC_IPR1 |= ((1 << 6) << 8);
}

void EXTI_Init()
{
	 __HAL_RCC_SYSCFG_CLK_ENABLE();

	 *EXTI_FTSR1 |= (1 << 0);

	 *EXTI_EXTICRx |= (0x3 << 0);

	 *EXTI_IMR1  |= (1 << 0);
}
void SPI_GPIO_Config()
{
	// SCK: PA5 (AF0)
	// MISO: PA6 (AF0)
	// MOSI: PA7 (AF0)
	// NSS: PB0	 (AF0)
	__HAL_RCC_GPIOA_CLK_ENABLE();
	__HAL_RCC_GPIOB_CLK_ENABLE();

	// Clear
	*GPIOA_MODER &= ~((0x3 << 10) | (0x3 << 12) | (0x3 << 14));
	*GPIOA_OSPEEDR &= ~((0x3 << 10) | (0x3 << 12) | (0x3 << 14));
	*GPIOA_AFRL &= ~((0xF << 20) | (0xF << 24) | (0xF << 28));

	*GPIOB_MODER &= ~((0x3 << 0));
	*GPIOB_OSPEEDR &= ~((0x3 << 0));
	*GPIOB_AFRL &= ~((0xF << 0));

	// Set
	*GPIOA_MODER |= ((0x2 << 10) | (0x2 << 12) | (0x2 << 14)); // PA5,PA6,PA7 AF mode
	*GPIOA_OSPEEDR |= ((0x2 << 10) | (0x2 << 12) | (0x2 << 14));// High Speed
	*GPIOA_AFRL &= ~((0xF << 20) | (0xF << 24) | (0xF << 28)); // PA5,PA6,PA7 as AF0

	*GPIOB_MODER |= ((0x2 << 0)); // PB0 - AF mode
	*GPIOB_OSPEEDR |= ((0x2 << 0));
	*GPIOB_AFRL &= ~((0xF << 0)); // PB0 - AF0

//	*GPIOB_MODER &= ~((0x3 << 0));
//
//	*GPIOB_PUPDR |= (1 << 0);

}

void SPI1_Init()
{
	__HAL_RCC_SPI1_CLK_ENABLE();

	// Clear
	*SPI1_CR1 &= ~((1 << 15) |
				   (1 << 14) |
				   (1 << 10) |
				    (1 << 9) |
					(1 << 8) |
					(1 << 7) |
					(1 << 6) |
					(3 << 3) |
					(1 << 2) |
					(1 << 1) |
					(1 << 0));

	*SPI1_CR2 &= ~((0xF << 8) | (1 << 2) | (1 << 12));

	// Set
	*SPI1_CR1 &= ~((1 << 15) | (1 << 14) | (1 << 10) |(1 << 7)); // Full-duplex

	*SPI1_CR1 |= (0x1 << 3); // 16 prescaler

	*SPI1_CR1 &= ~(1 << 7); // MSB First

	*SPI1_CR1 &= ~(1 << 2); // Slave configure

	*SPI1_CR1 |= ((1 << 1) | (1 << 0)); // CPHA = 1, CPOL = 1

	*SPI1_CR2 |= ((0x7 << 8) | (1 << 12)); // 8 bit Data size
}

void SPI_SS_Configure(uint8_t SSM_value)
{
	if(SSM_value == SSM_HARDWARE)
	{
		*SPI1_CR1 &= ~(1 << 9);
	}
	else
	{
		*SPI1_CR1 |= (1 << 9); // SSM
		*SPI1_CR1 &= ~(1 << 8); // SSI
	}
}
void SPI1_Enable_Disable(uint8_t value)
{
	if(value == 1)
	{
		*SPI1_CR1 |= (1 << 6);
	}
	else
	{
		*SPI1_CR1 &= ~(1 << 6);
	}
}

void SPI1_Transmit(uint8_t *TxBuffer, uint32_t size)
{
	if(((*SPI1_CR2 >> 8) & 0xF) == __8BIT__)
	{
		while(size)
		{
			while(!SPI_Flag(*SPI1_SR,SPI_TXE));
			*((__IO uint8_t *)SPI1_DR) = *TxBuffer;
			TxBuffer++;
			size--;
		}
	}
	else
	{
		while(size)
		{
			while(!SPI_Flag(*SPI1_SR,SPI_TXE));
			*SPI1_DR = *(uint16_t *)TxBuffer;
			TxBuffer += sizeof(uint16_t);
			size--;
		}
	}

	while(!SPI_Flag(*SPI1_SR,SPI_TXE));

	while(SPI_Flag(*SPI1_SR, SPI_BSY));

	uint8_t temp = *((__IO uint8_t *)SPI1_DR);

	temp = *((__IO uint8_t *)SPI1_SR);

}

void SPI1_Receive(uint8_t *RxBuffer, uint32_t size)
{
	if(((*SPI1_CR2 >> 8) & 0xF) == __8BIT__)
	{
		while(size)
		{
			while(SPI_Flag(*SPI1_SR, SPI_BSY));

			*(__IO uint8_t *)SPI1_DR = 0x00;

			if((*SPI1_SR & (1u << 0)))
			{
				(*(uint8_t *)RxBuffer) = *(__IO uint8_t *)SPI1_DR;
				RxBuffer++;
				size--;
			}
		}
	}
	else
	{
		while(size)
		{
			while(!SPI_Flag(*SPI1_SR,SPI_RXNE));
			*(uint16_t *)RxBuffer = *SPI1_DR;
			size--;
		}
	}

}

uint8_t Tx_Rx_SPI_1byte(uint8_t tx_data)
{
	uint8_t rx_data = 0;

	while(!SPI_Flag(*SPI1_SR,SPI_TXE));

	*(__IO uint8_t *)SPI1_DR = tx_data;

	while((!SPI_Flag(*SPI1_SR,SPI_RXNE)) || SPI_Flag(*SPI1_SR,SPI_BSY));

	rx_data = *(__IO uint8_t *)SPI1_DR;

	return rx_data;
}


void Tx_Rx_SPI_bytes(uint8_t *tx_data, uint8_t *rx_data, uint8_t size_tx, uint8_t size_rx)
{
	while(size_tx--)
	{
		while(!SPI_Flag(*SPI1_SR,SPI_TXE));

		*(__IO uint8_t *)SPI1_DR = *tx_data++;

		uint8_t temp = *(__IO uint8_t *)SPI1_DR;
	}

	while(size_rx--)
	{
		while((!SPI_Flag(*SPI1_SR,SPI_RXNE)) || SPI_Flag(*SPI1_SR,SPI_BSY));

		*rx_data++ = *(__IO uint8_t *)SPI1_DR;
	}
}
uint8_t Get_ACK_cmd(uint8_t ackbyte)
{
	if(ackbyte == 0xF5)
	{
		return 1;
	}
	else return 0;
}
