void SPI1_Transmit(uint8_t *TxBuffer, uint32_t size)
{
	if(((*SPI1_CR2 >> 8) & 0xF) == __8BIT__)
	{
		while(size)
		{
			while(!SPI_Flag(*SPI1_SR,SPI_TXE));
			*((__IO uint8_t *)SPI1_DR) = *TxBuffer;
			TxBuffer++;
			size--;
		}
	}
	else
	{
		while(size)
		{
			while(!SPI_Flag(*SPI1_SR,SPI_TXE));
			*SPI1_DR = *(uint16_t *)TxBuffer;
			TxBuffer += sizeof(uint16_t);
			size--;
		}
	}

	while(!SPI_Flag(*SPI1_SR,SPI_TXE));

	while(SPI_Flag(*SPI1_SR, SPI_BSY));

	uint8_t temp = *((__IO uint8_t *)SPI1_DR);

	temp = *((__IO uint8_t *)SPI1_SR);

}

void SPI1_Receive(uint8_t *RxBuffer, uint32_t size)
{
	if(((*SPI1_CR2 >> 8) & 0xF) == __8BIT__)
	{
		while(size)
		{
			while(SPI_Flag(*SPI1_SR, SPI_BSY));

			*(__IO uint8_t *)SPI1_DR = 0x00;

			if((*SPI1_SR & (1u << 0)))
			{
				(*(uint8_t *)RxBuffer) = *(__IO uint8_t *)SPI1_DR;
				RxBuffer++;
				size--;
			}
		}
	}
	else
	{
		while(size)
		{
			while(!SPI_Flag(*SPI1_SR,SPI_RXNE));
			*(uint16_t *)RxBuffer = *SPI1_DR;
			size--;
		}
	}

}

uint8_t Tx_Rx_SPI_1byte(uint8_t tx_data)
{
	uint8_t rx_data = 0;

	while(!SPI_Flag(*SPI1_SR,SPI_TXE));

	*(__IO uint8_t *)SPI1_DR = tx_data;

	while((!SPI_Flag(*SPI1_SR,SPI_RXNE)) || SPI_Flag(*SPI1_SR,SPI_BSY));

	rx_data = *(__IO uint8_t *)SPI1_DR;

	return rx_data;
}


void Tx_Rx_SPI_bytes(uint8_t *tx_data, uint8_t *rx_data, uint8_t size_tx, uint8_t size_rx)
{
	while(size_tx--)
	{
		while(!SPI_Flag(*SPI1_SR,SPI_TXE));

		*(__IO uint8_t *)SPI1_DR = *tx_data++;

		uint8_t temp = *(__IO uint8_t *)SPI1_DR;
	}

	while(size_rx--)
	{
		while((!SPI_Flag(*SPI1_SR,SPI_RXNE)) || SPI_Flag(*SPI1_SR,SPI_BSY));

		*rx_data++ = *(__IO uint8_t *)SPI1_DR;
	}
}
