void Excercise1()
{
	SPI1_Enable_Disable(ENABLE);

	cmd_code = Tx_Rx_SPI_1byte(0);

	if(cmd_code == 0x50)
	{
		Tx_Rx_SPI_1byte(ack_byte);

		Tx_Rx_SPI_bytes(&dummy_write, data_received, 1, 2);

		*GPIOD_ODR ^= (data_received[1] << data_received[0]);
	}

	cmd_code = Tx_Rx_SPI_1byte(0);

	if(cmd_code == 0x51)
	{
		Tx_Rx_SPI_1byte(ack_byte);

		Tx_Rx_SPI_bytes(led_ctrl, &dummy_read, 2, 2);
	}

	cmd_code = Tx_Rx_SPI_1byte(0);

	if(cmd_code == 0x52)
	{
		Tx_Rx_SPI_1byte(ack_byte);

		dummy_read = Tx_Rx_SPI_1byte(12);
	}

	cmd_code = Tx_Rx_SPI_1byte(0);

	if(cmd_code == 0x53)
	{
		Tx_Rx_SPI_1byte(ack_byte);

		data_length_receive = Tx_Rx_SPI_1byte(0);

		for(uint8_t i = 0; i < 19; i++)
		{
			data_received[0] = Tx_Rx_SPI_1byte(0);
		}
	}

	cmd_code = Tx_Rx_SPI_1byte(0);

	if(cmd_code == 0x54)
	{
		Tx_Rx_SPI_1byte(ack_byte);

		dummy_read = Tx_Rx_SPI_1byte(strlen(data));

		for(uint8_t i = 0; i < 13; i++)
		{
			Tx_Rx_SPI_1byte((uint8_t)data[i]);
		}

	}

	Tx_Rx_SPI_1byte(0);

	SPI1_Enable_Disable(DISABLE);
}

