/*
 * EXTI_PORT - This macro return 0 -> 7 for corresponding PORT A - I in EXTI
 * x is GPIO base address (PORT A -> I)
 */

#define EXTI_PORTCODE(x)		( ((x) == GPIOA) ? 0:\
								   (x == GPIOB) ? 1:\
								   (x == GPIOC) ? 2:\
								   (x == GPIOD) ? 3:\
								   (x == GPIOE) ? 4:\
								   (x == GPIOF) ? 5:\
								   (x == GPIOG) ? 6:\
								   (x == GPIOH) ? 7:\
								   (x == GPIOI) ? 8:0)

